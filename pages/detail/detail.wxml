<view class="page"><view wx:if="{{loading}}" class="notice">正在加载活动详情…</view><view wx:elif="{{errorMessage}}" class="empty"><text class="subtitle">活动详情暂时加载失败</text><text class="block muted section">{{errorMessage}}</text><button class="primary" bindtap="retry">重新加载</button><button class="secondary" bindtap="home">返回首页</button></view><block wx:elif="{{activity}}"><view class="detail-cover {{activity.theme}}"><view class="cover-sun"></view><view class="cover-hill"></view><text class="cover-word">{{activity.symbol}}</text><text class="cover-caption">WEEKEND TOGETHER / {{activity.category}}</text></view><view class="detail-heading card"><view class="row between wrap"><text class="tag">{{activity.joined ? '已加入 · ' + activity.joinedSeats + ' 人' : '正在招募伙伴'}}</text><text class="accent">{{activity.priceLabel}}</text></view><text class="title section">{{activity.title}}</text><text class="block muted section">{{activity.dateLabel}} · 约 {{activity.durationHours}} 小时</text><text class="block muted small">{{activity.locationName}} · 距示例位置 {{activity.distanceKm}} km</text></view>
<view wx:if="{{reason}}" class="notice"><text class="label">为什么推荐给你</text>{{reason}}</view>
<view class="card"><view class="section-head"><text class="subtitle">和谁一起去</text><text class="small muted">{{activity.joinedCount}} / {{activity.capacity}} 人</text></view><view class="members"><view wx:for="{{group.members}}" wx:key="id"><view class="avatar" style="background:{{item.color}}">{{item.initial}}</view><text class="tiny muted member-name">{{item.name}}</text></view><view wx:if="{{activity.joined}}"><view class="avatar">我</view><text class="tiny muted member-name">我方 {{activity.joinedSeats}} 人</text></view></view><text class="block muted small section">剩余 {{activity.remaining}} 个名额 · {{activity.tags}}</text></view>
<view class="card"><text class="subtitle">这次相聚</text><text class="block section">{{activity.description}}</text><view class="divider"></view><text class="label">集合地点</text><text class="block">{{activity.meetingPoint}}</text><text class="block small muted">{{activity.address}}</text><view class="divider"></view><text class="label">小小约定</text><text wx:for="{{group.rules}}" wx:key="*this" class="block rule">· {{item}}</text></view>
<view wx:if="{{!activity.joined}}" class="card"><text class="label">你和同行伙伴共几位？</text><picker range="{{availableSeats}}" value="{{seatIndex}}" bindchange="count"><view class="picker">{{seats}} 人（包含自己） ⌄</view></picker><text wx:if="{{seats > activity.remaining}}" class="block accent small section">当前剩余名额不足，请调整人数。</text></view>
<view class="notice">本地演示活动，不提供真实报名或支付。</view>
<view class="detail-actions"><button class="secondary favorite" bindtap="favorite">{{activity.favorite ? '♥ 已收藏' : '♡ 收藏'}}</button><button class="primary grow" bindtap="join" disabled="{{!activity.joined && (!activity.remaining || seats > activity.remaining)}}">{{activity.joined ? '进入群聊 →' : '加入拼团 →'}}</button></view><button wx:if="{{activity.joined}}" class="link section" bindtap="leave">退出拼团</button><button class="secondary section" open-type="share">分享这次相聚</button></block>
<view wx:else class="empty"><text class="subtitle">没有找到这个拼团</text><button class="primary" bindtap="home">返回首页</button></view></view>
