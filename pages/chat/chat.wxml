<view class="chat-page" wx:if="{{group && allowed}}"><view class="chat-header"><text class="tag">本地演示群聊</text><button class="link" bindtap="detail">查看活动 ›</button></view><view class="meeting"><text class="label">⌖ {{group.activity.meetingPoint}}</text><text class="small muted">{{group.activity.dateLabel}} · 已有 {{group.activity.joinedCount}} 人</text></view>
<scroll-view class="message-scroll" scroll-y="{{true}}" scroll-into-view="{{target}}" scroll-with-animation="{{true}}"><view class="message-list"><block wx:for="{{messages}}" wx:key="id"><view wx:if="{{item.type === 'system'}}" class="system-message" id="{{item.id}}">{{item.content}}</view><view wx:else class="message-row {{item.mine ? 'mine' : ''}}" id="{{item.id}}"><view class="avatar">{{item.initial}}</view><view class="message-content"><text class="sender">{{item.name}} · {{item.time}}</text><view class="bubble">{{item.content}}</view></view></view></block></view></scroll-view>
<view class="composer"><view class="quick-replies"><button class="chip" bindtap="quick" data-text="大家好，周末见！">打个招呼</button><button class="chip" bindtap="quick" data-text="我会提前到集合点。">确认集合</button></view><view class="row"><input class="chat-input grow" value="{{input}}" bindinput="input" maxlength="500" confirm-type="send" bindconfirm="send" placeholder="说点什么…" adjust-position="{{true}}"/><button class="send" bindtap="send" disabled="{{!input.length}}">发送</button></view></view></view>
<view wx:else class="page"><view class="empty"><text class="subtitle">{{group ? '加入拼团后再开始聊天' : '没有找到这个群聊'}}</text><button class="primary" bindtap="detail">{{group ? '查看拼团' : '回到首页'}}</button><button wx:if="{{group}}" class="secondary" bindtap="login">使用演示身份</button></view></view>
