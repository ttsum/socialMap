<view class="page"><text class="eyebrow">YOUR LITTLE CIRCLE</text><view class="hero"><view class="row"><view class="avatar">团</view><view class="grow"><text class="subtitle">{{loggedIn ? '周末探索家' : '你好，新朋友'}}</text><text class="small muted">{{loggedIn ? '演示身份 · 一起收集好时光' : '先随便逛逛，遇到喜欢的再加入'}}</text></view></view><button wx:if="{{!loggedIn}}" class="primary section" bindtap="login">使用演示身份</button><view wx:else class="row section"><view class="metric"><text class="metric-value">{{joined.length}}</text><text class="small muted">我的拼团</text></view><view class="metric"><text class="metric-value">{{favorites.length}}</text><text class="small muted">我的收藏</text></view></view></view>
<view class="section-head section"><view class="chips"><button class="chip {{selected === 'joined' ? 'active' : ''}}" data-value="joined" bindtap="select">我的拼团</button><button class="chip {{selected === 'favorites' ? 'active' : ''}}" data-value="favorites" bindtap="select">我的收藏</button></view><button class="link" bindtap="messages">消息 →</button></view>
<block wx:if="{{loggedIn}}"><activity-card wx:for="{{selected === 'joined' ? joined : favorites}}" wx:key="id" activity="{{item}}" bind:open="open"/><view wx:if="{{selected === 'joined' ? !joined.length : !favorites.length}}" class="empty"><text class="subtitle">{{selected === 'joined' ? '把下一次相聚安排上' : '把喜欢的活动留在这里'}}</text><text class="muted block section">{{selected === 'joined' ? '加入的拼团会显示在这里。' : '在活动详情中点击收藏，就能在这里找到。'}}</text><button class="secondary" bindtap="home">去首页发现</button></view></block><view wx:else class="empty"><text class="muted">使用演示身份，管理你的拼团和收藏。</text></view>
<view class="card section"><button class="row between menu-row" bindtap="about"><text>关于团团团</text><text class="muted">›</text></button><button wx:if="{{loggedIn}}" class="row between menu-row accent" bindtap="logout"><text>退出演示身份</text><text>›</text></button></view><text class="footer-note">记录仅保存在本机。清理小程序缓存会清除演示记录。</text></view>
