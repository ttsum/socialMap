.activity{padding:24rpx;background:#fff;border:1rpx solid #EAECE5;border-radius:16rpx;margin-bottom:20rpx;box-sizing:border-box}.pressed{opacity:.8}.top{display:flex;gap:22rpx;align-items:center}.art{position:relative;flex-shrink:0;width:152rpx;height:164rpx;border-radius:20rpx;overflow:hidden;background:#B9DFD3}.yellow{background:#F8D876}.lilac{background:#D8C9ED}.peach{background:#F6CABC}.sun{position:absolute;right:15rpx;top:16rpx;width:43rpx;height:43rpx;border-radius:50%;background:#FFFAE5}.hill{position:absolute;bottom:-46rpx;left:-20rpx;width:220rpx;height:120rpx;border-radius:50%;background:rgba(255,255,255,.35);transform:rotate(-15deg)}.symbol{position:absolute;left:26rpx;bottom:25rpx;font-size:58rpx;font-weight:800;color:#284B42}.body{flex:1;min-width:0}.title{font-size:30rpx;font-weight:750;color:#192234;line-height:1.4}.meta{color:#7B848C;font-size:23rpx;margin-top:8rpx}.bottom{display:flex;justify-content:space-between;gap:12rpx;align-items:center;margin-top:10rpx}.price{color:#D4644E;font-weight:700;font-size:26rpx}.seats{color:#6B8274;font-size:23rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:20rpx}.tag{font-size:21rpx;padding:5rpx 12rpx;border-radius:10rpx;background:#F3F4EE;color:#778176}.reason{border-top:1rpx solid #EEF0E9;margin-top:20rpx;padding-top:16rpx;color:#648572;font-size:23rpx;line-height:1.6}.match{display:block;font-weight:700;margin-bottom:6rpx}
