<view class="page"><block wx:if="{{intent}}"><text class="eyebrow">02 / A LITTLE MORE ABOUT YOU</text><text class="title">我们理解得对吗？</text><view class="hero section"><text class="tag">AI 需求卡 · 先确认再匹配</text><view class="spacer"></view><text>{{intent.query}}</text><text wx:if="{{meta}}" class="block hero-meta">{{meta.model}} · {{meta.promptVersion}} · {{meta.latencyMs}}ms</text></view><view wx:if="{{intent.notes && intent.notes.length}}" class="notice"><text wx:for="{{intent.notes}}" wx:key="*this" class="block">· {{item}}</text></view><view wx:if="{{intent.uncertainFields && intent.uncertainFields.length}}" class="notice warning"><text class="block">以下条件需要你确认：</text><text wx:for="{{intent.uncertainFields}}" wx:key="*this" class="tag warning-tag">{{item}}</text></view>
<view class="card"><text class="subtitle">确认这次相聚的条件</text><view class="field"><text class="label">同行总人数（包含自己）</text><input class="input" type="number" value="{{intent.people}}" data-key="people" bindinput="input" maxlength="2"/></view>
<view class="row"><view class="grow field"><text class="label">活动日期</text><picker range="{{days}}" value="{{dayIndex}}" bindchange="day"><view class="picker">{{days[dayIndex]}} ⌄</view></picker></view><view class="grow field"><text class="label">活动时段</text><picker range="{{periods}}" value="{{periodIndex}}" bindchange="period"><view class="picker">{{periods[periodIndex]}} ⌄</view></picker></view></view>
<view class="field"><text class="label">距离上限（公里）</text><input class="input" type="digit" value="{{intent.maxDistanceKm}}" data-key="maxDistanceKm" bindinput="input" maxlength="6"/></view><view class="field"><text class="label">人均预算上限（元）</text><input class="input" type="digit" value="{{intent.budgetPerPerson}}" data-key="budgetPerPerson" bindinput="input" maxlength="8"/></view><view class="field"><text class="label">偏好（用顿号分隔，影响排序）</text><input class="input" value="{{preferenceText}}" bindinput="preference" maxlength="100"/></view><view class="notice">示例城市：长沙。日期对应下一次周末的演示活动，距离不是实时定位结果；价格、距离和名额由活动数据决定。</view></view><button class="primary" bindtap="submit">确认并开始匹配 →</button><button class="link" bindtap="publish">重新描述需求</button></block>
<view wx:else class="empty"><text class="subtitle">还没有活动需求</text><button class="primary" bindtap="publish">先说说你的想法</button></view></view>
