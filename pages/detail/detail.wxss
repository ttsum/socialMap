.detail-cover{height:340rpx;border-radius:30rpx;position:relative;overflow:hidden;background:#B9DFD3}.detail-cover.yellow{background:#F7DD91}.detail-cover.lilac{background:#D8CAEB}.detail-cover.peach{background:#F4CDBD}.cover-sun{width:120rpx;height:120rpx;background:#FFF1A9;border-radius:50%;position:absolute;right:64rpx;top:44rpx}.cover-hill{width:900rpx;height:300rpx;background:rgba(255,255,255,.3);position:absolute;left:-40rpx;bottom:-170rpx;border-radius:50%;transform:rotate(-12deg)}.cover-word{font-size:150rpx;font-weight:800;position:absolute;left:55rpx;top:12rpx;color:#355C50}.cover-caption{position:absolute;bottom:36rpx;left:36rpx;font-size:22rpx;letter-spacing:3rpx;color:#345A4D}.detail-heading{margin-top:20rpx}.member-name{display:block;text-align:center;margin-top:8rpx}.rule{margin-top:14rpx;color:#68746E;font-size:26rpx}.detail-actions{display:flex;gap:18rpx;align-items:center}.detail-actions .favorite{width:200rpx;flex-shrink:0}.detail-actions .grow{width:auto}
