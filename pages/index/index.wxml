<view class="page">
<view class="section-head"><view class="row"><view class="brand">团</view><view><text class="subtitle">团团团</text><text class="small muted">长沙 · 让相聚自然发生</text></view></view><text class="tag">本地演示</text></view>
<view class="hero"><text class="hero-mark">团</text><view class="hero-copy"><text class="eyebrow">GOOD COMPANY, GREAT WEEKEND</text><text class="title">长沙周末，<text class="block">和谁一起去？</text></text><view class="spacer"></view><text class="block muted">说说你的想法，找到合拍的小团体。</text><button class="search-entry" bindtap="publish"><text>周六下午，想找个安静的活动…</text><text class="arrow">↗</text></button></view></view>
<view class="home-shortcuts"><button class="shortcut" bindtap="map"><text class="shortcut-icon">⌖</text><text class="block">附近的相聚</text><text class="tiny muted">在地图上找灵感</text></button><button class="shortcut yellow" bindtap="publish"><text class="shortcut-icon">✦</text><text class="block">说说你的期待</text><text class="tiny muted">人数、预算、好心情</text></button></view>
<view wx:if="{{joinedCount}}" class="joined-banner row between" bindtap="messages"><text>你已加入 {{joinedCount}} 个拼团</text><text>去群里聊聊 →</text></view>
<view class="section"><view class="section-head"><text class="subtitle">周末灵感清单</text><button class="link" bindtap="map">地图找团 →</button></view><view class="chips"><button wx:for="{{categories}}" wx:key="*this" class="chip {{category === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectCategory">{{item}}</button></view><view class="spacer"></view><view wx:if="{{loading}}" class="notice">正在加载活动…</view><view wx:elif="{{errorMessage}}" class="empty"><text class="subtitle">活动暂时加载失败</text><text class="block muted section">{{errorMessage}}</text><button class="primary" bindtap="retry">重新加载</button></view><block wx:else><activity-card wx:for="{{activities}}" wx:key="id" activity="{{item}}" bind:open="open"/></block></view>
<text class="footer-note">一起出发，小事也值得期待。</text></view>
