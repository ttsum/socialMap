page{background:#FAF8F2;color:#192234;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.55}
view,text,button,input,textarea{box-sizing:border-box}button{margin:0;padding:0;background:transparent;font-size:inherit;line-height:1.5;color:inherit;border-radius:0}button::after{border:0}button[disabled]{color:#8B9096;background:#E4E6E5}button:active{opacity:.8}
.page{padding:32rpx 32rpx calc(44rpx + env(safe-area-inset-bottom))}.block{display:block}.row{display:flex;align-items:center;gap:16rpx}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}
.title{display:block;font-size:46rpx;line-height:1.3;font-weight:800;letter-spacing:0}.subtitle{display:block;font-size:34rpx;font-weight:750;line-height:1.4}.muted{color:#77818D}.small{font-size:24rpx}.tiny{font-size:22rpx}.accent{color:#DB664F}
.eyebrow{display:block;font-size:22rpx;font-weight:700;letter-spacing:3rpx;margin-bottom:18rpx;color:#72827C}.section{margin-top:36rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx}
.card{background:white;border:1rpx solid #EAECE5;border-radius:16rpx;padding:28rpx;margin-bottom:20rpx}.hero{background:#192234;color:#FFFCF3;border-radius:32rpx;padding:36rpx;position:relative;overflow:hidden}.hero .muted{color:#C1C8CC}.hero .title{max-width:540rpx}.hero .eyebrow{color:#F9D86B}.hero-mark{position:absolute;right:-18rpx;top:8rpx;color:#F9D86B;font-size:160rpx;line-height:1;opacity:.14;transform:rotate(-16deg)}.hero-copy{position:relative;z-index:1}
.primary,.secondary,.danger{width:100%;padding:25rpx 28rpx;border-radius:20rpx;font-weight:700;text-align:center}.primary{background:#EB755D;color:white}.secondary{background:#F0F3ED;color:#293F36}.danger{color:#C85A4A;background:#FFF0EB}.inline-button{padding:12rpx 20rpx;font-size:25rpx;border-radius:16rpx;background:#F0F3ED;white-space:nowrap}.link{color:#C65945;font-size:25rpx;padding:12rpx 0;white-space:nowrap}
.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chip{padding:12rpx 22rpx;border-radius:30rpx;background:#F0F1E9;color:#68736A;font-size:24rpx}.chip.active{background:#192234;color:#FFFDF4}.tag{display:inline-block;padding:5rpx 14rpx;border-radius:12rpx;background:#EAF5EE;color:#477C6A;font-size:22rpx}
.notice{margin:20rpx 0;color:#78816F;background:#F1F2E8;padding:18rpx 22rpx;border-radius:16rpx;font-size:24rpx}.empty{text-align:center;padding:64rpx 28rpx;background:white;border-radius:16rpx;margin-top:28rpx}.empty-icon{font-size:64rpx;color:#B9CDC0;margin-bottom:20rpx}.empty .primary,.empty .secondary{margin-top:28rpx}.spacer{height:24rpx}
.field{margin-top:24rpx}.label{display:block;font-size:26rpx;font-weight:650;margin-bottom:12rpx}.input,.picker{width:100%;min-height:88rpx;padding:20rpx 24rpx;border-radius:16rpx;background:#F4F5F0;color:#192234}textarea.input{height:280rpx;line-height:1.65}input.input{height:88rpx}.divider{height:1rpx;background:#EBEDE7;margin:24rpx 0}
.avatar{width:70rpx;height:70rpx;border-radius:50%;flex-shrink:0;display:flex;justify-content:center;align-items:center;background:#F8D9C9;color:#283A34;font-weight:700}.members{display:flex;gap:16rpx;flex-wrap:wrap}.metric{flex:1;text-align:center;padding:12rpx}.metric-value{display:block;font-size:38rpx;font-weight:750}.footer-note{display:block;text-align:center;margin-top:32rpx;color:#949B98;font-size:22rpx}
