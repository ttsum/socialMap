.chat-page{height:100vh;display:flex;flex-direction:column;background:#F3F6F0;overflow:hidden}.chat-header{display:flex;align-items:center;justify-content:space-between;padding:16rpx 28rpx;background:#FAF8F2;flex-shrink:0}.meeting{margin:12rpx 28rpx;padding:22rpx;background:#E2EFE4;border-radius:20rpx;flex-shrink:0}.meeting .label{margin-bottom:4rpx}.message-scroll{flex:1;min-height:0;height:0}.message-list{padding:18rpx 26rpx 36rpx}.system-message{text-align:center;color:#8D968D;font-size:22rpx;padding:18rpx 25rpx;overflow-wrap:break-word}.message-row{display:flex;align-items:flex-start;gap:16rpx;margin:24rpx 0}.message-content{max-width:76%;min-width:0}.sender{font-size:21rpx;color:#8B938D;display:block;margin-bottom:8rpx}.bubble{padding:20rpx 24rpx;background:#fff;border-radius:0 22rpx 22rpx 22rpx;font-size:27rpx;white-space:pre-wrap;overflow-wrap:break-word;word-break:break-all}.mine{flex-direction:row-reverse}.mine .sender{text-align:right}.mine .bubble{background:#192234;color:#FAFAF3;border-radius:22rpx 0 22rpx 22rpx}.mine .avatar{background:#EDC4B4}.composer{padding:20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));background:#FAF8F2;flex-shrink:0}.quick-replies{display:flex;gap:14rpx;margin-bottom:16rpx}.chat-input{background:#fff;height:88rpx;border-radius:20rpx;padding:18rpx 22rpx;font-size:26rpx}.send{padding:22rpx 26rpx;background:#EA745A;color:white;border-radius:18rpx;font-size:26rpx}
